<?xml version="1.0"?>
<robot name="concrete_bag_box_chain">

  <!-- Root link: seg_2 (center segment) -->
  <link name="seg_2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.35 0.102 0.15"/></geometry>  <!-- X=width, Y=length, Z=thickness -->
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.35 0.102 0.15"/></geometry>
    </collision>
  </link>

  <!-- Left side segments (seg_1 and seg_0) -->
  <link name="seg_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.35 0.102 0.135"/></geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.35 0.102 0.135"/></geometry>
    </collision>
  </link>

  <link name="seg_0">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.35 0.102 0.12"/></geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.35 0.102 0.12"/></geometry>
    </collision>
  </link>

  <!-- Right side segments (seg_3 and seg_4) -->
  <link name="seg_3">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.35 0.102 0.135"/></geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.35 0.102 0.135"/></geometry>
    </collision>
  </link>

  <link name="seg_4">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.35 0.102 0.12"/></geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.35 0.102 0.12"/></geometry>
    </collision>
  </link>

  <!-- Joints branching from center (seg_2) along Y-axis -->
  <!-- Bending around X-axis so it flexes in Y-Z plane -->
  
  <joint name="j_2_1" type="revolute">
    <parent link="seg_2"/>
    <child link="seg_1"/>
    <origin xyz="0 -0.122 0" rpy="0 0 0"/>  <!-- Negative Y to go left -->
    <axis xyz="1 0 0"/>  <!-- Rotate around X-axis -->
    <limit lower="-0.133" upper="0.133" effort="500" velocity="2.0"/>
    <dynamics damping="5.0" friction="1.0"/>
  </joint>

  <joint name="j_1_0" type="revolute">
    <parent link="seg_1"/>
    <child link="seg_0"/>
    <origin xyz="0 -0.122 0" rpy="0 0 0"/>  <!-- Continue left along Y -->
    <axis xyz="1 0 0"/>
    <limit lower="-0.133" upper="0.133" effort="500" velocity="2.0"/>
    <dynamics damping="5.0" friction="1.0"/>
  </joint>

  <joint name="j_2_3" type="revolute">
    <parent link="seg_2"/>
    <child link="seg_3"/>
    <origin xyz="0 0.122 0" rpy="0 0 0"/>  <!-- Positive Y to go right -->
    <axis xyz="1 0 0"/>
    <limit lower="-0.133" upper="0.133" effort="500" velocity="2.0"/>
    <dynamics damping="5.0" friction="1.0"/>
  </joint>

  <joint name="j_3_4" type="revolute">
    <parent link="seg_3"/>
    <child link="seg_4"/>
    <origin xyz="0 0.122 0" rpy="0 0 0"/>  <!-- Continue right along Y -->
    <axis xyz="1 0 0"/>
    <limit lower="-0.133" upper="0.133" effort="500" velocity="2.0"/>
    <dynamics damping="5.0" friction="1.0"/>
  </joint>

</robot>